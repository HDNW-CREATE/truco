{
  "name": "truco-na-mesa-3d",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @truco/server --filter @truco/client dev",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p packages/shared && tsc -p packages/engine && tsc -p apps/server && tsc -p apps/client",
    "lint": "eslint .",
    "format": "prettier --write .",
    "cli": "tsx packages/engine/cli/main.ts",
    "db:push": "pnpm --filter @truco/server db:push",
    "preparar": "node scripts/setup.mjs",
    "build": "pnpm --filter @truco/client build",
    "start": "pnpm --filter @truco/server start"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "esbuild"
    ]
  }
}